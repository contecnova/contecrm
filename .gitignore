# Entorno
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Configuración local: `.env` lleva secretos reales y NUNCA se commitea.
# Lo que se versiona es `.env.example`, que documenta cada clave con su
# explicación y valores de ejemplo seguros.
.env
.env.local
.env.*.local

# Datos y salidas locales
data/
# El almacén local de adjuntos (STORAGE_LOCAL_PATH por defecto). Lo llenan el
# desarrollo y la suite de pruebas, y son bytes de ficheros subidos: no tienen
# nada que hacer en el repositorio.
datos/
var/
logs/
*.log

# Sistema
.DS_Store

# Sitio de documentación generado por mkdocs
site/

# Dependencias y salida de compilación del front oficial.
frontend/node_modules/
frontend/dist/

# Constancia de qué nivel de comprobación corrió EN ESTA MÁQUINA. No se versiona
# a propósito: un clon recién hecho tiene que decir «aquí no consta ningún pase»,
# que es la verdad. Si viajara con el repositorio, diría que pasó en la máquina
# de otro y eso es justo la coartada que este apunte existe para quitar.
.verificacion-bloque
