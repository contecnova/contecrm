        "plantilla_id",
        "source_type"
      ]
    }
  },
  "/api/sources/{source_id}": {
    "delete": {
      "campos": []
    }
  },
  "/api/query/plan": {
    "post": {
      "campos": [
        "agrupaciones",
        "columnas",
        "filtros",
        "limite",
