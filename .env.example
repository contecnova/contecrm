# ═══════════════════════════════════════════════════════════════════
#  contecrm — configuración
# ═══════════════════════════════════════════════════════════════════
#
# GENERADO por `python scripts/gen_env_example.py`. No se edita a mano:
# la explicación de cada ajuste vive junto a su campo en
# `packages/crmcore/crmcore/config_parts/*.py`, y de ahí sale esto. Si
# editas aquí, el siguiente `--check` lo revierte.
#
# Copia este fichero a `.env` y cambia lo que marque CAMBIAME. `.env`
# NUNCA se commitea: está en .gitignore.
#
# Todo ajuste es una variable de entorno. Los que además se pueden
# cambiar en caliente por tenant, sin reiniciar, están en
# `crmcore/runtime/keys.py` y se editan desde la consola de
# administración: ahí el valor de aquí es solo el punto de partida.


# ── Identidad del servicio y red ────────────────────────────────

# Cada proceso declara qué servicio es. Lo usan los logs, las métricas
# (etiqueta `service`), el bus (nombre del consumidor durable), el esquema
# de base de datos que le toca y el registro de servicios.
# 
# No tiene default útil a propósito: un proceso que no sabe qué servicio es
# produce telemetría inservible y, peor, podría conectarse al esquema
# equivocado. `crmcore.service.crear_servicio()` lo exige.
SERVICE_NAME=

SERVICE_VERSION=0.1.0

# Entorno de ejecución (CRM-07.02.01.01: desarrollo, pruebas, UAT y
# producción son despliegues separados, distinguidos por este valor).
# 
# "prod" por defecto para que un despliegue que se olvide de poner ENV pase
# por la verificación estricta de secretos en vez de saltársela (el error
# seguro es fallar al arrancar, no arrancar inseguro).
ENV=prod

# Nombre del producto en textos visibles (correos, cabeceras, títulos de
# OpenAPI). Configurable porque la marca blanca (CRM-00.01.04.06) lo cambia.
APP_NAME=contecrm

# Puerto en el que escucha este servicio. Lo leen uvicorn (arranque),
# el healthcheck de compose y el gateway (enrutado). Boot-only: cambiarlo
# en caliente no reabre el socket.
SERVICE_HOST=127.0.0.1

SERVICE_PORT=8000

# URL base pública del sistema, usada para componer enlaces absolutos
# (callbacks de OAuth, enlaces de correo, URLs firmadas). Sin esto los
# enlaces salen relativos y rotos en el correo.
PUBLIC_BASE_URL=http://localhost:8080

# Lista separada por comas. Vacío = ningún origen de navegador permitido,
# que es lo correcto para un servicio interno: solo el gateway habla con él.
CORS_ORIGINS=

# Prefijo de versión de la API pública. El versionado es explícito y por
# URI (CRM-00.02.01.05): un cambio rompedor estrena `v2` y `v1` sigue
# sirviéndose hasta su fecha de retirada.
API_PREFIX=/api/v1

# Fecha de retirada de ESTA versión mayor, en ISO-8601, o vacío si no hay
# una anunciada. Cuando está puesta, toda respuesta lleva las cabeceras
# `Sunset` y `Deprecation` (CRM-00.02.01.07) para que los consumidores se
# enteren por el canal que ya están leyendo, sin depender de una circular.
API_SUNSET_DATE=

# Documentación interactiva. Se puede apagar en producción si el operador
# prefiere no publicar el esquema, aunque por defecto va encendida: un
# sistema headless sin documentación navegable es mucho peor que uno que
# enseña su contrato.
API_DOCS_ENABLED=true


# ── Base de datos y aislamiento en el motor ─────────────────────

# Un servicio se conecta SIEMPRE con un rol propio, sin permisos sobre los
# esquemas de los demás (CRM-00.03.01.02). `deploy/crear-bases.sh` crea un
# rol y un esquema por servicio; esta URL apunta al suyo.
# 
# El default es el de desarrollo local que levanta `docker-compose.yml`.
# En producción viene del entorno y `crmcore.config` exige que no sea este.
DATABASE_URL=postgresql+psycopg://contecrm:contecrm_dev_only@localhost:5432/contecrm

# URL con el rol administrador, usada SOLO por las migraciones. Separarlas
# es lo que permite que el rol de la aplicación no tenga DDL: si el proceso
# que atiende peticiones no puede crear ni alterar tablas, una inyección no
# puede alterarlas tampoco.
DATABASE_ADMIN_URL=

# Esquema propio del servicio. Vacío = se deriva de `service_name`.
# Explicitarlo sirve para los servicios que comparten esquema en un
# despliegue pequeño (un solo proceso, varios dominios).
DB_SCHEMA=

# El total de conexiones simultáneas por proceso es `pool_size + overflow`.
# Defaults conservadores para un servicio de API: la mayoría de peticiones
# retienen la conexión milisegundos. Un servicio con trabajos largos
# (importaciones, orquestador) sube estos valores en su `.env`.
DB_POOL_SIZE=10

DB_MAX_OVERFLOW=10

DB_POOL_TIMEOUT_S=30

# Recicla conexiones antes de que un proxy o el propio Postgres las cierre
# por inactividad; media hora va por debajo de los timeouts habituales.
DB_POOL_RECYCLE_S=1800

# Fallar rápido si Postgres no responde, en vez de bloquear el worker el
# tiempo por defecto del TCP del sistema (75 s o más). Un worker colgado es
# lo que convierte una base caída en un sistema que "se queda pensando".
DB_CONNECT_TIMEOUT_S=5

# Row-Level Security activa. Es la garantía dura de CRM-00.01.02.01: aunque
# una consulta olvide el filtro de tenant, el motor no devuelve filas
# ajenas.
# 
# Va a `true` por defecto, al revés que en contecmind, donde nació apagada
# para no cambiar el comportamiento de un sistema ya en producción. Aquí no
# hay nada en producción todavía, así que el default puede ser el correcto
# desde el principio.
# 
# AVISO HONESTO: un rol SUPERUSER o con BYPASSRLS se salta RLS aunque esté
# FORCE. Con `rls_enabled=true` el arranque comprueba que el rol de conexión
# no los tiene y se niega a arrancar si los tiene (ver `crmcore.db.session`).
RLS_ENABLED=true

# Guard de tenant en la capa ORM: segunda red, independiente de RLS, que
# inyecta el filtro de tenant en todo SELECT/UPDATE/DELETE de un modelo con
# `tenant_id`. Se puede apagar para una consulta administrativa legítima,
# pero apagarlo globalmente en producción deja el sistema con una sola red.
TENANT_GUARD_ENABLED=true

# Aplicar migraciones al arrancar. En desarrollo es cómodo; en producción se
# deja en false y las aplica un paso aparte, para que dos réplicas no migren
# a la vez (mismo criterio que contecpos).
DB_MIGRATE_ON_BOOT=false


# ── Multi-tenancy, cuotas y residencia ──────────────────────────

# Cuatro vías, por orden de confianza: el claim del token > la clave de API
# > la cabecera explícita > el subdominio. Las dos primeras están firmadas;
# las dos últimas son PISTAS de enrutado y nunca bastan por sí solas para
# conceder acceso. Esa distinción es la que evita que baste con cambiar una
# cabecera para entrar en otro tenant.
# 
# Dominio raíz para el enrutado por subdominio: `<slug>.<raíz>`. Vacío
# desactiva el subdominio como pista.
TENANT_ROOT_DOMAIN=

# Nombre de la cabecera que lleva el slug del tenant. Configurable porque un
# despliegue detrás de un proxy corporativo puede necesitar otra.
TENANT_HEADER=X-Tenant

# pool   = esquema compartido con discriminador (CRM-00.01.01.01)
# schema = un esquema por tenant                (CRM-00.01.01.02)
# silo   = base o clúster dedicado              (CRM-00.01.01.03)
# El modelo híbrido por tiers (CRM-00.01.01.04) sale de que este valor sea
# una propiedad DEL TENANT, no del despliegue: esto es solo el default con
# el que se dan de alta.
TENANT_DEFAULT_ISOLATION=pool

# Región por defecto para el pinning de datos (CRM-00.01.05.01). El valor
# no significa nada por sí mismo: lo interpreta el despliegue. Se guarda en
# el tenant para poder auditar dónde vive cada dato.
TENANT_DEFAULT_REGION=eu

# Son los topes con los que nace un tenant sin plan asignado. El plan los
# sobrescribe, y el operador puede subirlos por tenant desde Admin. Cero =
# sin límite, que es lo razonable para un despliegue on-premise de un solo
# cliente donde las cuotas solo estorban.
QUOTA_API_CALLS_POR_MINUTO=1000

QUOTA_REGISTROS=0

QUOTA_ALMACENAMIENTO_MB=0

QUOTA_CORREOS_POR_DIA=0

QUOTA_WORKFLOWS_CONCURRENTES=100

QUOTA_TOKENS_IA_POR_DIA=CAMBIAME

# Usuarios activos que admite el plan. 0 = sin límite, que es lo razonable
# en un despliegue on-premise de un solo cliente.
LICENCIAS_MAXIMAS=0

# Porcentaje de consumo a partir del cual se avisa al tenant de que se
# acerca al límite (CRM-00.01.06.06). Avisar al 100 % es avisar tarde.
QUOTA_AVISO_PCT=80

# Alta autoservicio. Apagada por defecto: un despliegue empresarial da de
# alta a sus tenants por API o por consola, y dejar abierto el alta pública
# en una instalación privada es una superficie regalada.
ONBOARDING_ENABLED=false


# ── Bus de eventos, outbox y webhooks ───────────────────────────

# nats     JetStream: persistencia, consumidores durables, replay y
# reparto entre réplicas. Es el de producción.
# redis    Redis Streams: sirve donde ya hay Redis y no se quiere una pieza
# más; con grupos de consumidores da reparto y reintento.
# memoria  En proceso, sin red. SOLO pruebas: productor y consumidor viven
# en el mismo proceso y no hay nada que limpiar.
# 
# El código de negocio no sabe cuál está activo: publica contra
# `crmcore.bus.Bus` y el backend se elige aquí (CRM-00.02.02.05).
BUS_BACKEND=nats

NATS_URL=nats://localhost:4222

REDIS_URL=redis://localhost:6379/0

# Prefijo de todos los subjects. Aísla despliegues que compartan broker
# (un NATS común para pre-producción y demo, por ejemplo).
BUS_PREFIX=contecrm

# El evento se escribe en la MISMA transacción que el cambio que lo
# provoca, y un relevo lo publica después. Es lo que impide el estado
# imposible: oportunidad ganada en la base y nadie enterado en el bus.
# 
# El precio es entrega at-least-once —un evento puede publicarse dos veces
# si el proceso muere entre publicar y marcar—, y por eso TODO consumidor
# es idempotente por `dedup_key` (CRM-00.02.02.04).
OUTBOX_ENABLED=true

# Cuántos eventos publica el relevo por vuelta. Lotes grandes reducen
# viajes pero alargan el bloqueo de las filas tomadas.
OUTBOX_LOTE=100

# Cada cuánto vuelve a mirar si hay pendientes cuando la última vuelta salió
# vacía. Con eventos esperando publica de seguido, sin esperar.
OUTBOX_INTERVALO_S=1.0

# Intentos antes de mandar el evento a la cola de fallidos. Con backoff
# exponencial, 8 intentos cubren varios minutos de caída del broker.
OUTBOX_MAX_INTENTOS=8

# Base del backoff exponencial entre intentos, en segundos.
OUTBOX_BACKOFF_BASE_S=2.0

# Registro de `dedup_key` ya procesadas. Es lo que convierte la entrega
# at-least-once en efecto exactly-once desde fuera.
INBOX_ENABLED=true

# Cuánto se recuerda una clave. Debe cubrir de sobra la ventana de
# reintentos del productor; una semana la cubre con holgura.
INBOX_RETENCION_DIAS=7

WEBHOOKS_ENABLED=true

WEBHOOK_TIMEOUT_S=10.0

WEBHOOK_MAX_INTENTOS=6

WEBHOOK_BACKOFF_BASE_S=5.0

# Ventana en la que se acepta la firma de una petición entrante, para que
# un mensaje capturado no se pueda reenviar más tarde (anti-replay).
WEBHOOK_FIRMA_VENTANA_S=300

# Tamaño máximo del cuerpo que se entrega. Un payload gigante es casi
# siempre un error de diseño y además revienta al receptor.
WEBHOOK_MAX_PAYLOAD_KB=256


# ── Identidad: tokens, sesiones, MFA y federación ───────────────

# Firma TODOS los tokens de acceso y refresco. Si en producción sigue
# valiendo el placeholder, cualquiera puede emitirse un token de
# administrador: el arranque lo comprueba y se niega a levantar.
SECRET_KEY=CAMBIAME

JWT_ALGORITHM=HS256

# Duración del token de acceso. Corta a propósito: la revocación de una
# sesión no puede invalidar un JWT ya emitido, así que el tiempo de vida ES
# la ventana de exposición. 15 minutos es el equilibrio habitual entre eso
# y no renovar constantemente.
ACCESS_TOKEN_MINUTOS=CAMBIAME

# El refresco sí es revocable (está en base de datos), por eso puede durar.
REFRESH_TOKEN_DIAS=CAMBIAME

# Sesiones simultáneas por usuario. 0 = sin límite. Ponerlo a 1 es lo que
# exigen algunos clientes regulados.
SESIONES_MAX_POR_USUARIO=0

# Caducidad por inactividad, además de la absoluta del refresco.
SESION_INACTIVIDAD_MINUTOS=480

LOGIN_MAX_INTENTOS=5

LOGIN_BLOQUEO_MINUTOS=15

MFA_ENABLED=true

# Exigir MFA a todo el mundo. Lo normal es exigirla por rol (se configura
# por tenant); esto es el interruptor global para instalaciones que la
# quieren obligatoria sin excepciones.
MFA_OBLIGATORIA=false

# Ventana de códigos TOTP aceptados hacia atrás y adelante, para absorber
# relojes desajustados. Cada paso son 30 s; 1 = ±30 s.
TOTP_VENTANA_PASOS=1

OIDC_ENABLED=false

SAML_ENABLED=false

SCIM_ENABLED=false

# Crear el usuario la primera vez que entra por el proveedor de identidad.
# Cómodo y estándar, pero significa que quien controle el IdP crea usuarios
# aquí: por eso es configurable y no un hecho.
JIT_PROVISIONING=true

# Caducidad por defecto de una clave de API nueva. 0 = sin caducidad, que se
# desaconseja y por eso no es el default.
API_KEY_CADUCIDAD_DIAS=CAMBIAME

# Longitud en bytes del secreto generado (se muestra en base64url una sola
# vez). 32 bytes = 256 bits.
API_KEY_BYTES=CAMBIAME

# El soporte puede entrar como un usuario del tenant, pero: con motivo
# escrito, con caducidad corta y dejando rastro en la auditoría. Sin las
# tres cosas, es un agujero con buena intención.
SUPLANTACION_ENABLED=true

SUPLANTACION_MAX_MINUTOS=60

SUPLANTACION_EXIGE_MOTIVO=true


# ── Límites, resiliencia y topes de proceso ─────────────────────

RATE_LIMIT_ENABLED=true

# Ventana de conteo. Una ventana corta reacciona antes a una ráfaga; una
# larga tolera mejor el tráfico a golpes de un proceso por lotes.
RATE_LIMIT_VENTANA_S=60

# Topes por dimensión. Se aplican TODOS: el más restrictivo manda. Están
# separados porque el abuso tiene formas distintas — un usuario con un
# bucle, una integración mal configurada, un tenant entero desbocado.
RATE_LIMIT_POR_USUARIO=600

RATE_LIMIT_POR_API_KEY=CAMBIAME

RATE_LIMIT_POR_TENANT=6000

RATE_LIMIT_POR_IP=1200

MAX_BODY_MB=25

# Tope de elementos en una operación masiva (CRM-00.02.01.11). Por encima,
# la API obliga a usar el camino asíncrono con job id, que es el que tiene
# progreso, reanudación e informe parcial.
BULK_MAX_ITEMS=1000

# Tope de operaciones en una petición compuesta (CRM-00.02.01.13).
COMPOSITE_MAX_OPS=25

# Página máxima que se puede pedir. Sin tope, un `limit=1000000` es una
# denegación de servicio escrita por el propio cliente sin querer.
PAGE_MAX_SIZE=200

PAGE_DEFAULT_SIZE=50

# Timeout de una llamada entre servicios. Corto: encadenar tres llamadas
# con timeouts largos convierte un servicio lento en una caída general.
HTTP_INTERNO_TIMEOUT_S=10.0

# Timeout de una llamada a un sistema externo (ERP, firma, telefonía).
# Más largo porque no controlamos su latencia, pero acotado igual.
HTTP_EXTERNO_TIMEOUT_S=30.0

# Una petición que pasa de aquí se corta y devuelve 504. Existe para que
# una consulta patológica no retenga una conexión del pool indefinidamente.
REQUEST_TIMEOUT_S=60.0

CIRCUIT_BREAKER_ENABLED=true

# Fallos consecutivos que abren el circuito.
CB_UMBRAL_FALLOS=5

# Tiempo que permanece abierto antes de dejar pasar una petición de prueba.
CB_REPOSO_S=30

DEGRADACION_ENABLED=true

# Uso del pool de conexiones (0..1) a partir del cual se difiere lo no
# crítico: recálculos, enriquecimientos, informes programados. Se difiere,
# no se pierde.
DEGRADACION_UMBRAL_POOL=0.85

# Topes que impiden un proceso desbocado. Sin ellos, una automatización que
# se dispara a sí misma consume el sistema entero.
PROCESO_MAX_PASOS=1000

PROCESO_MAX_PROFUNDIDAD=10

PROCESO_MAX_DURACION_H=720

# Cadena máxima de automatizaciones que se disparan unas a otras
# (CRM-00.03.03.06).
AUTOMATIZACION_MAX_CASCADA=5

# Longitud máxima de un comentario. 10.000 caracteres son unas tres páginas:
# de sobra para explicar un caso, y un tope que impide que alguien pegue un
# contrato entero en una nota y lo convierta en la fila más pesada de la
# tabla.
COMENTARIO_MAX_CARACTERES=10000

# Menciones por comentario. Sin tope, un solo comentario puede generar un
# aviso para toda la empresa.
COMENTARIO_MAX_MENCIONES=20

# `memoria` o `redis`. En memoria vale para desarrollo y para las pruebas;
# con más de una réplica deja de valer, porque cada proceso tendría la suya
# y una purga en uno no alcanzaría a los demás. El arranque avisa.
CACHE_BACKEND=memoria

CACHE_URL=

# TTL por defecto de una entrada. Cinco minutos: suficiente para absorber la
# ráfaga de una pantalla que pide lo mismo diez veces, y lo bastante corto
# para que un dato cambiado desde otra vía no se quede pegado.
CACHE_TTL_S=300

# Tope duro. Una entrada con un TTL enorme mantiene ocupada la memoria de lo
# ya invalidado por una purga, que no borra: hace inalcanzable.
CACHE_TTL_MAX_S=3600

# Segundos que cada proceso recuerda la generación de un tenant sin volver a
# preguntarla. Durante esa ventana una réplica puede seguir sirviendo lo
# purgado: es el precio explícito de no pagar un viaje de red por lectura.
CACHE_TTL_GENERACION_S=5


# ── Observabilidad: logs, métricas, trazas y auditoría ──────────

LOG_LEVEL=INFO

# json en producción (lo consume el agregador), consola en desarrollo (lo
# lee una persona). `auto` decide por `env`.
LOG_FORMAT=auto

# Hashear PII (correos, IPs, user-agents) en los logs. `None` = encendido
# fuera de desarrollo y apagado en desarrollo, donde poder buscar un correo
# en el log es justo lo que se necesita para depurar.
LOG_REDACT_PII=

# Cuerpo de las peticiones en el log. Apagado: es la vía más rápida de
# filtrar datos personales a un sistema de logs que no está pensado para
# guardarlos.
LOG_REQUEST_BODY=false

METRICS_ENABLED=true

METRICS_PATH=/metrics

# Etiquetar las métricas con el tenant. Da visibilidad por cliente, que es
# lo que pide el catálogo, pero multiplica las series por el número de
# tenants: con miles de tenants hay que apagarlo o muestrear.
METRICS_POR_TENANT=true

# Tope de tenants distintos etiquetados. Pasado el tope, el resto se agrupa
# en `otros`. Es lo que evita que la cardinalidad tumbe a Prometheus.
METRICS_MAX_TENANTS=200

TRACING_ENABLED=false

OTEL_ENDPOINT=http://localhost:4317

# Fracción de peticiones trazadas (0..1). 1.0 en desarrollo; en producción
# se baja porque el coste es real y una muestra basta para ver la forma.
OTEL_SAMPLE_RATIO=0.1

AUDIT_ENABLED=true

# Encadenar cada apunte con el hash del anterior. Convierte el log en
# verificable: si alguien borra o edita una fila, la cadena se rompe y se
# puede demostrar. Cuesta un hash por apunte.
AUDIT_HASH_CHAIN=true

# Retención antes de archivar o purgar (CRM-00.05.04.04). Seis años cubre
# los plazos mercantiles habituales en España.
AUDIT_RETENCION_DIAS=2190

# Exportación a SIEM: destino syslog/HTTP. Vacío = no se exporta.
AUDIT_SIEM_URL=

# Tiempo máximo que puede tardar una comprobación de readiness antes de
# darla por fallida. Corto: un readiness lento hace que el orquestador
# crea que el servicio está caído.
HEALTH_CHECK_TIMEOUT_S=3.0


# ── Protección del dato: cifrado, secretos y cabeceras ──────────

# Clave maestra de la que derivan las claves de cifrado de campo. Si está
# vacía, los campos marcados como cifrados NO se pueden escribir y el
# arranque avisa: preferimos un fallo visible a guardar en claro algo que
# el modelo declaró sensible.
ENCRYPTION_KEY=CAMBIAME

# Clave anterior, para poder descifrar lo escrito antes de una rotación.
# Mantenerla mientras dura el recifrado es lo que hace la rotación posible
# sin ventana de caída.
ENCRYPTION_KEY_PREVIA=CAMBIAME

# BYOK/CMEK (CRM-00.01.04.09): cuando está activo, la clave la aporta el
# tenant y se guarda cifrada con la maestra. Revocarla deja sus datos
# ilegibles a propósito, que es justo lo que el cliente compra.
BYOK_ENABLED=false

# Backend del almacén de secretos por tenant. `db` los guarda cifrados en
# la base; `vault` delega en un gestor externo. Genérico a propósito: la
# configuración decide, no el código.
SECRETOS_BACKEND=CAMBIAME

SECRETOS_VAULT_URL=

# Aplicar máscara por rol en las respuestas de API y en las exportaciones.
# Se hace en la serialización, no en la consulta, para que el mismo dato se
# vea completo o enmascarado según quién pregunte sin duplicar consultas.
MASKING_ENABLED=true

DLP_ENABLED=true

# Filas a partir de las cuales una exportación se considera masiva: se
# audita siempre y, según política, se bloquea o pide aprobación.
DLP_EXPORT_FILAS_AVISO=5000

DLP_EXPORT_FILAS_BLOQUEO=100000

# Días que un registro borrado se conserva antes de poder destruirse. Un mes
# es el plazo con el que casi todos los errores humanos se detectan: quien
# borró algo por error lo echa en falta en la siguiente revisión mensual.
PAPELERA_DIAS_RETENCION=30

# HSTS en segundos. 0 = no se envía. Un año es el valor que piden las
# listas de precarga.
HSTS_MAX_AGE=31536000

# Confiar en las cabeceras de proxy (X-Forwarded-For). Solo debe activarse
# si de verdad hay un proxy delante: si no, cualquiera falsea su IP y se
# salta el rate limiting y las listas de permitidos.
TRUST_PROXY_HEADERS=false

# Redes desde las que se aceptan esas cabeceras, separadas por comas.
TRUSTED_PROXIES=
